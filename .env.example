# Copy to .env.local (git-ignored). Only NEXT_PUBLIC_* values reach the browser; never put secrets in them.
# Firebase project. "demo-" IDs are offline-only in the Emulator Suite. Do not change until the user approves a real project.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-starflames
# Point the client SDK at the local emulators (true for all local dev and tests).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# Client SDK emulator hosts (host:port). Must match the ports in firebase.json.
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:6104
NEXT_PUBLIC_AUTH_EMULATOR_HOST=127.0.0.1:6106
NEXT_PUBLIC_STORAGE_EMULATOR_HOST=127.0.0.1:6107
NEXT_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1:6103
# Admin SDK emulator hosts (server only, host:port). Must match the ports in firebase.json.
FIRESTORE_EMULATOR_HOST=127.0.0.1:6104
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:6106
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:6107
# Server only. Skip google-auth-library's GCE metadata-server probe (a ~3 s network timeout on first Admin Firestore use). Emulator dev only. Next loads .env.local in dev, build and start, so deployments must never ship .env.local.
METADATA_SERVER_DETECTION=none
# Server only. Guard: firebase-admin refuses any non-"demo-*" project unless this is "true". Leave false until the user approves production.
FIREBASE_ALLOW_NON_DEMO_PROJECT=false
# Server only, read at build time. "true" builds the dev-only pages under /dev (e.g. /dev/tokens) into a production build; only the e2e harness sets it (the Playwright webServer, scripts/e2e.ts). Leave false.
ENABLE_DEV_PAGES=false
# Tests only; never set it by hand. scripts/e2e.ts sets it after its own build, so the Playwright webServer only runs `next start`.
# E2E_PREBUILT=1
# Tests only; never set it by hand. scripts/emulators-exec.ts (test:e2e, test:rules) sets it for the command it runs under `firebase emulators:exec`: a temp folder holding the command and its recorded exit code.
# EMULATORS_EXEC_DIR=
